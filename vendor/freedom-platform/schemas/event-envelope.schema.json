{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.freedom.example/schemas/event-envelope/v1.json",
  "title": "Freedom Domain Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "communityid",
    "traceid",
    "contractversion",
    "aggregateid",
    "aggregateversion",
    "eventsequence",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "type": {
      "type": "string",
      "pattern": "^freedom\\.[a-z0-9_.-]+\\.v[1-9][0-9]*$"
    },
    "source": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "maxLength": 200
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri"
    },
    "correlationid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "causationid": {
      "type": "string",
      "maxLength": 128
    },
    "communityid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "traceid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contractversion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Shared contract bundle/envelope revision. Event payload compatibility is governed by the event type major version and dataschema, not by this field."
    },
    "aggregateid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "aggregateversion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Canonical state version after this fact. It increments for every accepted internal transition, so it may jump between published integration events."
    },
    "eventsequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Contiguous sequence of published integration events for this aggregate, independent of aggregateversion. Consumers detect and repair public-event gaps with this field."
    },
    "data": {
      "type": "object",
      "required": ["actor"],
      "properties": {
        "actor": {"$ref": "#/$defs/actor"},
        "rule_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/ruleRef"}
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "acting_as"],
      "properties": {
        "type": {
          "enum": ["user", "organization", "activity_guest", "service", "integration", "system"],
          "description": "Accountable principal. An AI agent is recorded in agent_execution and is never the principal."
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "acting_as": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Exact profession membership, office, service role, or system function used for this action."
        },
        "agent_execution": {
          "$ref": "#/$defs/agentExecution"
        },
        "human_signature_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Present when this exact effect required and received an A4 human signature."
        },
        "action_intent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Stable idempotent intent for the external or consequential effect."
        }
      }
    },
    "agentExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_connection_id", "agent_run_id", "execution_grant_id"],
      "properties": {
        "agent_connection_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "agent_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "execution_grant_id": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "description": "Execution provenance only; changing agent or role never creates an independent human review."
    },
    "ruleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"}
      }
    }
  }
}
